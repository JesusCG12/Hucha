<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema claro: la página usa sus colores claros (prefers-color-scheme: light). -->
    <style name="Theme.Hucha" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/papel</item>
        <item name="android:statusBarColor">@color/papel</item>
        <item name="android:navigationBarColor">@color/hoja</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
